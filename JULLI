<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RizzByJulius Admin</title>
<style>:root{--bg:#0d0d12;--card:#17171f;--line:#2a2a36;--tx:#f3f3f7;--mu:#9a9aae;--ac:#ff4d6d}
@media (prefers-color-scheme:light){:root{--bg:#f6f6f9;--card:#fff;--line:#e2e2ea;--tx:#15151c;--mu:#6b6b7e}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.4 system-ui,sans-serif}main{max-width:720px;margin:0 auto;padding:16px}
h1{margin:0 0 4px}h2{font-size:16px;margin:20px 0 8px}.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px;margin-bottom:10px}
.r{display:flex;justify-content:space-between;gap:8px;align-items:center;flex-wrap:wrap}small{color:var(--mu)}
input,select{width:100%;background:var(--bg);color:var(--tx);border:1px solid var(--line);border-radius:10px;padding:10px;font:inherit;margin-bottom:8px}
button{font:inherit;color:var(--tx);background:var(--card);border:1px solid var(--line);border-radius:999px;padding:8px 14px;cursor:pointer}button.p{background:var(--ac);border:0;color:#fff}button.d{color:#f87171;border-color:#f87171}a{color:var(--ac)}.ok{color:#34d399}.tabs{display:flex;gap:6px;margin-bottom:12px}.tabs a{flex:1;text-align:center;padding:10px;border:1px solid var(--line);border-radius:999px;text-decoration:none;color:var(--tx);background:var(--card)}.tabs a.on{background:var(--ac);color:#fff;border-color:transparent}.hide{display:none!important}.er{color:#f87171}</style></head><body><main>
<div class="tabs"><a class="on" href="#">Admin panel</a><a href="/">Use website</a></div>
<div class="r"><h1>Admin</h1></div><small id="plan"></small>
<h2>Dashboard</h2><div class="card" id="dash"></div><div id="expSoon"></div>
<div class="card"><div class="r"><b id="pendTxt">Payments</b><button id="enableAlerts">Enable alerts</button></div></div>
<h2>Payment number</h2><form class="card" id="payForm"><input id="payNum" placeholder="Airtel number users pay to" inputmode="tel"><button class="p" type="submit">Save number</button><p id="payMsg" style="margin:8px 0 0"></p><small id="payBy"></small></form>
<h2>Amount users pay (UGX)</h2><form class="card" id="priceForm"><input id="priceIn" type="number" min="500" inputmode="numeric" placeholder="e.g. 3000"><button class="p" type="submit">Save amount</button><p id="priceMsg" style="margin:8px 0 0"></p></form>
<h2>WhatsApp contact (shown on the home page)</h2><form class="card" id="waForm"><input id="waIn" placeholder="+256741829090" inputmode="tel"><button class="p" type="submit">Save WhatsApp number</button><p id="waMsg" style="margin:8px 0 0"></p></form>
<h2>Announcement banner (shown to everyone)</h2><form class="card" id="anForm"><input id="anIn" maxlength="200" placeholder="e.g. New feature today! (leave empty to hide)"><button class="p" type="submit">Post announcement</button><p id="anMsg" style="margin:8px 0 0"></p></form>
<h2>Add member</h2><form class="card" id="add"><input id="nm" placeholder="Name" autocomplete="off"><input id="ph" placeholder="Phone number used on the website" inputmode="tel"><input id="days" type="number" min="1" max="3650" placeholder="Access days (leave empty for no expiry)"><button class="p" type="submit">Add member</button><p id="msg" style="margin:8px 0 0"></p></form>
<div id="pend"></div>
<form class="card hide" id="addAdm"><b>Add admin</b> <small>(owner only)</small><input id="ap" placeholder="Phone number" inputmode="tel"><input id="au" placeholder="Username" autocapitalize="none"><input id="aw" type="text" placeholder="Password (8+ characters)" autocomplete="off"><button class="p" type="submit">Add admin</button><p id="amsg" style="margin:8px 0 0"></p></form>
<h2>Payments</h2><div id="pay"></div><h2>Users <small id="cnt"></small></h2><input id="q" type="search" placeholder="Search by name or phone number"><div id="usr"></div></main>
<script>
const $=id=>document.getElementById(id),esc=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const call=(u,m,b)=>fetch(u,{method:m||"GET",headers:{"Content-Type":"application/json"},body:b?JSON.stringify(b):undefined}).then(async r=>({ok:r.ok,status:r.status,j:await r.json().catch(()=>({}))}));
const d=t=>new Date(t).toLocaleString();let O={},lastPend=null;
async function load(){const r=await call("/api/admin/overview");if(!r.ok){location.href="/";return}const j=O=r.j;
const na=j.users.filter(u=>u.role==="admin").length;
$("payNum").value!==undefined&&document.activeElement!==$("payNum")&&($("payNum").value=j.payNumber||"");$("payBy").textContent=j.payBy?"Last changed by "+j.payBy:"";
const st=j.stats||{};$("dash").innerHTML=`<div class="r" style="gap:12px"><div><b>${st.users}</b><br><small>users</small></div><div><b>${st.newWeek}</b><br><small>new (7 days)</small></div><div><b>${st.active}</b><br><small>active plans</small></div><div><b>${st.freeUsed}</b><br><small>free uses</small></div></div><hr style="border:0;border-top:1px solid var(--line);margin:10px 0"><div class="r" style="gap:12px"><div><b>${(st.paidTotal||0).toLocaleString()} UGX</b><br><small>collected total</small></div><div><b>${(st.paidWeek||0).toLocaleString()} UGX</b><br><small>last 7 days</small></div><div><b>${st.paidCount}</b><br><small>payments</small></div></div>`;
$("expSoon").innerHTML=(j.expiring||[]).length?`<h2>Expiring soon</h2>`+j.expiring.map(u=>`<div class="card r"><div><b>${esc(u.username)}</b> · ${esc(u.phone||"")}<br><small>ends ${d(u.sub_until)}</small></div><a href="https://wa.me/256${esc(String(u.phone||"").slice(1))}?text=${encodeURIComponent("Hi "+u.username+", your RizzByJulius access ends soon. Open the app to renew and keep going.")}" target="_blank" rel="noopener">Remind on WhatsApp</a></div>`).join(""):"";
document.activeElement!==$("anIn")&&($("anIn").value=j.announcement||"");
document.activeElement!==$("priceIn")&&($("priceIn").value=j.plan.price);document.activeElement!==$("waIn")&&($("waIn").value="+"+(j.whatsapp||""));
const pend=j.payments.filter(p=>p.status==="pending");$("pendTxt").textContent=pend.length?`🔔 ${pend.length} payment${pend.length>1?"s":""} waiting for approval`:"No payments waiting";document.title=(pend.length?`(${pend.length}) `:"")+"Admin";
if(lastPend!==null&&pend.length>lastPend)ping("New payment: "+pend[0].username+" · "+pend[0].amount+" UGX");lastPend=pend.length;
$("plan").textContent=`${j.plan.free} free uses · ${j.plan.price} UGX for ${j.plan.days} days · Admins ${na}/${j.maxAdmins} · In-app mobile money ${j.autoPay?"on":"off"}`;$("cnt").textContent="("+j.users.length+")";
$("addAdm").classList.toggle("hide",!(j.isOwner&&na<j.maxAdmins));
$("pend").innerHTML=(j.members||[]).map(m=>`<div class="card r"><div><b>${esc(m.name)}</b> · ${esc(m.phone)}<br><small>Waiting to sign up · ${m.days>=3650?"no expiry":m.days+" days"}</small></div><button class="d" data-m="${esc(m.phone)}">Cancel</button></div>`).join("");
$("pay").innerHTML=j.payments.map(p=>`<div class="card r"><div><b>${esc(p.username)}</b> · ${esc(p.amount)} UGX<br><small>TXN ${esc(p.txn)} · ${d(p.created_at)} · ${esc(p.status)}</small></div>${p.status==="pending"?`<div><button class="p" data-a="approve" data-i="${p.id}">Approve</button> <button data-a="reject" data-i="${p.id}">Reject</button></div>`:""}</div>`).join("")||"<small>No payments yet.</small>";
const Q=($("q").value||"").trim().toLowerCase().replace(/\s/g,"");$("usr").innerHTML=j.users.filter(u=>!Q||u.username.toLowerCase().includes(Q)||String(u.phone||"").includes(Q.replace(/^\+?256/,"0"))).map(u=>{const rm=u.id!==j.meId&&(u.role!=="admin"||j.isOwner)&&!(u.role==="admin"&&u.id===1&&false);
return `<div class="card r"><div><b>${esc(u.username)}</b> · ${esc(u.phone||"")} ${u.role==="admin"?"· admin":""}<br><small>${u.free_used} free used · ${u.sub_until>Date.now()?"active until "+d(u.sub_until):"no active plan"} · joined ${d(u.created_at)}</small></div><div><button data-g="${u.id}">Grant days</button> <button data-r="${u.id}" data-n="${esc(u.username)}">Reset password</button> ${rm?`<button class="d" data-x="${u.id}" data-n="${esc(u.username)}">Remove</button>`:""}</div></div>`}).join("")}
const flash=(el,r,ok)=>{el.className=r.ok?"ok":"er";el.textContent=r.ok?ok(r.j):(r.j.error||"Something went wrong.")};
$("add").onsubmit=async e=>{e.preventDefault();const r=await call("/api/admin/members","POST",{name:$("nm").value,phone:$("ph").value,days:+$("days").value||0});flash($("msg"),r,j=>j.message);if(r.ok){$("add").reset();load()}};
$("addAdm").onsubmit=async e=>{e.preventDefault();const r=await call("/api/admin/admins","POST",{phone:$("ap").value,username:$("au").value,password:$("aw").value});flash($("amsg"),r,()=>"Admin added.");if(r.ok){$("addAdm").reset();load()}};
$("payForm").onsubmit=async e=>{e.preventDefault();const r=await call("/api/admin/settings","POST",{payNumber:$("payNum").value});flash($("payMsg"),r,()=>"Payment number updated.");if(r.ok)load()};
$("priceForm").onsubmit=async e=>{e.preventDefault();const r=await call("/api/admin/settings","POST",{price:$("priceIn").value});flash($("priceMsg"),r,()=>"Amount updated. New payments use it.");if(r.ok)load()};
$("waForm").onsubmit=async e=>{e.preventDefault();const r=await call("/api/admin/settings","POST",{whatsapp:$("waIn").value});flash($("waMsg"),r,()=>"WhatsApp number updated.");if(r.ok)load()};
$("anForm").onsubmit=async e=>{e.preventDefault();const r=await call("/api/admin/settings","POST",{announcement:$("anIn").value});flash($("anMsg"),r,()=>"Announcement updated.");if(r.ok)load()};
let T;$("q").oninput=()=>{clearTimeout(T);T=setTimeout(load,250)};
function ping(t){try{const c=new(window.AudioContext||window.webkitAudioContext)(),o=c.createOscillator();o.connect(c.destination);o.frequency.value=880;o.start();setTimeout(()=>o.stop(),250)}catch(e){}try{if(window.Notification&&Notification.permission==="granted")new Notification("RizzByJulius",{body:t})}catch(e){}}
$("enableAlerts").onclick=async()=>{try{await Notification.requestPermission();ping("Alerts are on")}catch(e){}};
setInterval(load,20000);
document.addEventListener("click",async e=>{const t=e.target;
if(t.dataset.a){await call(`/api/admin/payments/${t.dataset.i}/${t.dataset.a}`,"POST");load()}
if(t.dataset.g){const n=prompt("Grant how many days?","7");if(n){await call(`/api/admin/users/${t.dataset.g}/grant`,"POST",{days:+n});load()}}
if(t.dataset.m){await call("/api/admin/members/"+encodeURIComponent(t.dataset.m),"DELETE");load()}
if(t.dataset.r&&confirm("Reset password for "+t.dataset.n+"?")){const r=await call("/api/admin/users/"+t.dataset.r+"/reset","POST");alert(r.ok?"Temporary password for "+t.dataset.n+": "+r.j.password+"\n\nSend it to them privately and ask them to change it.":(r.j.error||"Couldn't reset."))}
if(t.dataset.x&&confirm("Remove "+t.dataset.n+"? This deletes their account and payments.")){const r=await call("/api/admin/users/"+t.dataset.x,"DELETE");if(!r.ok)alert(r.j.error||"Couldn't remove.");load()}});
load();
</script></body></html>
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>RizzByJulius — your AI wingman</title>
<style>
:root{--bg:#0d0d12;--card:#17171f;--line:#2a2a36;--tx:#f3f3f7;--mu:#9a9aae;--ac:#ff4d6d;--ac2:#ff8a5c;--ok:#34d399;--mid:#fbbf24;--lo:#f87171;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root[data-theme="light"]{--bg:#f6f6f9;--card:#fff;--line:#e2e2ea;--tx:#15151c;--mu:#6b6b7e}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#f6f6f9;--card:#fff;--line:#e2e2ea;--tx:#15151c;--mu:#6b6b7e}}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:560px;margin:0 auto;padding:16px 16px 48px}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
h1{font-size:26px;margin:0;letter-spacing:-.5px}h1 span{background:linear-gradient(90deg,var(--ac),var(--ac2));-webkit-background-clip:text;background-clip:text;color:transparent}
.sub{color:var(--mu);margin:0 0 16px;font-size:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:14px}
.tabs{display:flex;gap:6px;margin-bottom:14px}
.tab,.chip,.btn,.ib{font:inherit;color:var(--tx);cursor:pointer;border:1px solid var(--line);background:var(--card);border-radius:999px}
.tab{flex:1;padding:12px 6px;font-size:14px;font-weight:600}
.tab.on,.chip.on{background:linear-gradient(90deg,var(--ac),var(--ac2));border-color:transparent;color:#fff}
.chips{display:flex;flex-wrap:wrap;gap:8px}.chip{padding:10px 16px;font-size:15px;min-height:44px}
label,.lbl{display:block;font-size:13px;color:var(--mu);margin:0 0 6px;font-weight:600}
textarea,input[type=text],input[type=password],select{width:100%;background:var(--bg);color:var(--tx);border:1px solid var(--line);border-radius:12px;padding:12px;font:inherit;resize:vertical}
textarea{min-height:90px}
.btn{width:100%;padding:16px;font-size:17px;font-weight:700;border-radius:14px;background:linear-gradient(90deg,var(--ac),var(--ac2));color:#fff;border:0}
.btn:disabled{opacity:.5}.ghost{background:transparent;color:var(--tx);border:1px solid var(--line);font-weight:600}
.ib{padding:8px 14px;font-size:14px;min-height:40px}
.up{display:flex;align-items:center;gap:10px;border:1.5px dashed var(--line);border-radius:12px;padding:12px;cursor:pointer;margin-bottom:10px;color:var(--mu)}
.up img{height:56px;border-radius:8px}.up input{display:none}
input[type=range]{width:100%;accent-color:var(--ac)}.sl{display:flex;justify-content:space-between;font-size:12px;color:var(--mu)}
.rep{border-top:1px solid var(--line);padding:12px 0}.rep:first-of-type{border:0}
.rep p{margin:0 0 6px;font-size:17px}.why{color:var(--mu);font-size:13px;margin:0 0 8px}
.pill{display:inline-block;padding:4px 12px;border-radius:999px;font-weight:700;font-size:13px;color:#111}
.hi{background:var(--ok)}.neutral{background:var(--mid)}.low{background:var(--lo)}
.warn{border-color:var(--lo);background:rgba(248,113,113,.1);border-radius:12px;border:1px solid;padding:10px;margin:10px 0;font-size:14px}
.tip{font-size:14px;margin:8px 0 0}.hide{display:none!important}.tabs2{display:flex;gap:6px;margin-bottom:14px}a.ib{text-decoration:none;display:inline-block}.err{color:var(--lo);font-size:14px}
.score{font-size:44px;font-weight:800;line-height:1}
.h{display:flex;justify-content:space-between;gap:8px;padding:10px 0;border-top:1px solid var(--line);font-size:14px}.h small{color:var(--mu)}
.note{color:var(--mu);font-size:12px;text-align:center;margin-top:18px}
.row{display:flex;gap:8px;align-items:center;justify-content:space-between}
</style></head><body><main>
<header><h1>Rizz<span>ByJulius</span></h1><button class="ib" id="theme" aria-label="Toggle theme">🌓</button></header>
<p class="sub">Your AI wingman for dating apps and texts.</p>
<div id="ann" class="hide" style="background:rgba(255,77,109,.12);border:1px solid var(--ac);border-radius:12px;padding:10px;margin-bottom:12px;font-size:14px;display:flex;justify-content:space-between;gap:8px"><span id="annTxt"></span><button class="ib" id="annX" style="min-height:0;padding:2px 10px">✕</button></div>
<div class="hide" id="home"><h2 style="font-size:28px;margin:6px 0;line-height:1.2">Never run out of things to say.</h2><p class="sub" style="font-size:16px">Upload a chat or paste her reply. RizzByJulius reads the vibe and gives you 3 replies that sound like you.</p><div class="card"><p style="margin:0 0 8px">📷 Reads chat screenshots</p><p style="margin:0 0 8px">🎭 Flirty, spicy, casual, funny or motivating</p><p style="margin:0 0 8px">📊 Honest interest-level read</p><p style="margin:0" id="priceLine">🎁 10 free tries, then 3000 UGX for 7 days</p></div><a id="wa" class="btn ghost hide" style="display:block;text-align:center;text-decoration:none" target="_blank" rel="noopener" href="#">💬 Need help? Chat with us on WhatsApp</a></div>
<div class="card hide" id="authCard"><div class="tabs2" id="authTabs"><button class="tab on" data-a="login">Log in</button><button class="tab" data-a="signup">Sign up</button></div>
<form id="authForm"><label for="ph">Phone number</label><input type="text" id="ph" inputmode="tel" autocomplete="tel" placeholder="0701234567"><div style="height:10px"></div><label for="un">Username</label><input type="text" id="un" autocomplete="username" autocapitalize="none"><div style="height:10px"></div><label for="pw">Password</label><input type="password" id="pw" autocomplete="current-password"><div id="sgnBox" class="hide"><div id="otpRow" class="row hide" style="gap:8px;margin-top:10px"><input type="text" id="otp" inputmode="numeric" placeholder="SMS code" style="flex:1"><button type="button" class="ib" id="otpBtn">Send code</button></div>
<input type="text" id="rf" placeholder="Invite code (optional)" style="margin-top:10px" autocapitalize="characters">
<label style="display:flex;gap:8px;align-items:flex-start;margin:10px 0 0;color:var(--tx)"><input type="checkbox" id="agree" style="width:auto;margin-top:3px"><span>I'm 18 or older and agree to the <a href="/terms" target="_blank" rel="noopener">Terms</a></span></label></div>
<div style="margin-top:14px"><button class="btn" id="authGo">Log in</button></div><p class="err" id="authErr"></p><p class="sub" style="margin:4px 0 0"><a href="#" id="fpLink" style="color:var(--mu)">Forgot password?</a></p></form>
<form id="fpForm" class="hide" style="margin-top:12px"><div class="lbl">Reset password</div><div id="fpNoSms" class="hide"><p class="sub">Contact us on WhatsApp and an admin will reset your password.</p></div>
<div id="fpSms" class="hide"><input type="text" id="fpPh" inputmode="tel" placeholder="Your phone number"><div class="row" style="gap:8px;margin-top:8px"><input type="text" id="fpCode" inputmode="numeric" placeholder="SMS code" style="flex:1"><button type="button" class="ib" id="fpSend">Send code</button></div><input type="password" id="fpNew" placeholder="New password (8+ characters)" autocomplete="new-password" style="margin-top:8px"><div style="margin-top:10px"><button class="btn" type="submit">Set new password</button></div></div><p class="sub" id="fpMsg"></p></form><p class="sub">New accounts get 10 free uses. You stay signed in on this device.</p>
<p class="sub" style="margin:8px 0 0"><a href="#" id="admLink" style="color:var(--mu)">Admin access</a></p>
<form id="codeForm" class="hide"><label for="code">Admin code</label><input type="password" id="code" autocomplete="off" autocapitalize="characters"><div style="margin-top:10px"><button class="btn" type="submit">Enter</button></div><p class="err" id="codeErr"></p></form></div>
<div class="card hide" id="bar"><div class="row"><div><b id="who"></b><br><small id="cred" style="color:var(--mu)"></small></div><div><a class="ib hide" id="adm" href="/admin">Admin</a> <button class="ib" id="chpw">Password</button> <button class="ib" id="logout">Log out</button></div></div>
<div id="invBox" class="hide" style="margin-top:10px"><small style="color:var(--mu)">Invite a friend with your code: you both get extra free tries.</small><div class="row" style="margin-top:6px"><b id="invCode"></b><button class="ib" id="invCopy">Copy invite link</button></div></div>
<form id="cpForm" class="hide" style="margin-top:10px"><input type="password" id="cpOld" placeholder="Current password" autocomplete="current-password"><input type="password" id="cpNew" placeholder="New password (8+ characters)" autocomplete="new-password" style="margin-top:8px"><div style="margin-top:8px"><button class="btn" type="submit">Change password</button></div><p class="sub" id="cpMsg"></p></form></div>
<div class="card hide" id="payCard"><div class="lbl" id="payLbl">Free trial finished</div><p id="payInfo" style="margin:0 0 10px"></p>
<div id="autoBox" class="hide"><label for="mmNet">Mobile money network</label><select id="mmNet"><option value="AIRTEL">Airtel Money</option><option value="MTN">MTN MoMo</option></select><div style="height:10px"></div><label for="mmPhone">Mobile money number</label><input type="text" id="mmPhone" inputmode="tel" placeholder="0741234567"><div style="margin-top:10px"><button class="btn" id="mmGo">Pay with mobile money</button></div><p class="sub" id="mmMsg"></p><p class="sub" style="margin:10px 0">Or pay manually:</p></div>
<p id="manInfo" class="sub" style="margin:0 0 8px"></p><input type="text" id="txn" placeholder="Airtel transaction ID"><div style="margin-top:10px"><button class="btn ghost" id="payGo">I've paid manually, submit</button></div><p class="sub" id="payMsg"></p><button class="ib" id="payRef">Refresh my access</button></div>
<div id="app" class="hide">

<div class="tabs"><button class="tab on" data-m="reply">Reply</button><button class="tab" data-m="rate">Rate mine</button><button class="tab" data-m="opener">Opener</button></div>

<div class="card" id="moodCard"><div class="lbl">Mood — pick 1 or mix 2</div><div class="chips" id="chips"></div>
<div style="margin-top:14px"><div class="lbl">Reply length</div><input type="range" id="len" min="0" max="2" value="1"><div class="sl"><span>Short</span><span>Medium</span><span>Long</span></div></div><div style="margin-top:14px"><label for="lang">Reply language</label><select id="lang"><option>English</option><option>Luganda</option><option>Swahili</option></select></div></div>

<div class="card">
<label class="up" id="upBox"><span id="upTxt">📷 <b id="upLbl">Upload chat screenshot</b></span><input type="file" id="file" accept="image/*"></label>
<div id="rm" class="hide" style="margin-bottom:10px"><button class="ib" id="rmBtn">Remove screenshot</button></div>
<label id="inLbl" for="inp">Or type / paste her reply</label>
<textarea id="inp" placeholder="her message…"></textarea>
