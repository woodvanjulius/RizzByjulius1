 db.prepare('UPDATE otps SET tries=tries+1 WHERE phone=? AND purpose=?').run(phone,purpose);
 const ok=otpHash(String(code||'').trim())===o.hash;
 if(ok)db.prepare('DELETE FROM otps WHERE phone=? AND purpose=?').run(phone,purpose);
 return ok;
}
